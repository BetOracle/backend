# FootyOracle Backend Configuration

# Server Configuration
PORT=5000
DEBUG=True
PREDICTION_DEBUG=False

REQUESTS_PER_MINUTE=8

# Agent Configuration
MOCK_MODE=True
BACKEND_URL=http://localhost:5000

# Database (PostgreSQL required)
DATABASE_URL=

# ------------------------------------------------------------------
# Football Data API (Optional — uses mock/AI data when key is absent)
# ------------------------------------------------------------------

# Primary match/standings data → https://www.football-data.org/
# This is the only required API. AI enrichment fills in the rest.
FOOTBALL_API_KEY=
FOOTBALL_API_URL=https://api.football-data.org/v4

# ------------------------------------------------------------------
# AI Enrichment (Replaces broken APIs)
# ------------------------------------------------------------------
# AI enrichment provides injury analysis, form insights, and market odds
# Choose provider: "anthropic" or "openai"
AI_PROVIDER=anthropic
AI_ENRICHMENT_ENABLED=True

# Set ONE of the following API keys:
# Anthropic (Claude) → https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI → https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Mock mode for testing without AI costs
AI_MOCK_MODE=False

# ------------------------------------------------------------------
# Prediction Engine Thresholds
# ------------------------------------------------------------------
# Only surface picks where edge >= MIN_EDGE AND confidence >= MIN_CONFIDENCE
MIN_EDGE=0.15
MIN_CONFIDENCE=0.60

# ------------------------------------------------------------------
# Discord Bot
# ------------------------------------------------------------------
# Get bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Right-click channel → Copy ID (requires Developer Mode)
DISCORD_CHANNEL_ID=

# ------------------------------------------------------------------
# Celo / Blockchain (Now in scope since Lynn is out)
# ------------------------------------------------------------------
# Set to "True" to enable on-chain prediction recording
BLOCKCHAIN_ENABLED=False

# Celo RPC URLs (Mainnet for hackathon deployment)
CELO_RPC_URL=https://forno.celo.org
# For testnet: https://alfajores-forno.celo-testnet.org

# Contract Addresses (set after deploying contracts)
AGENT_WALLET=           # Address of deployed agent wallet
PREDICTION_CONTRACT=    # Address of prediction registry
AGENT_ID=               # bytes32 agent ID

# Backend signing key (needs CELO for gas)
# This wallet must be authorized in the agent wallet contract
AGENT_PRIVATE_KEY=      # 0x... (64 hex chars)

# ------------------------------------------------------------------
# CORS (for frontend - if we add one later)
# ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,https://footyoracle.streamlit.app

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
